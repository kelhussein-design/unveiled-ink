<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>FakeCheck — AI Detection Aggregator</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080A12; color: #fff; font-family: 'Space Mono', 'JetBrains Mono', monospace; min-height: 100vh; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
@keyframes fadeIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
@keyframes scanline { 0%{transform:translateY(-100%)} 100%{transform:translateY(100vh)} }
.ambient { position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse at 20% 20%,rgba(14,165,233,0.04) 0%,transparent 60%),radial-gradient(ellipse at 80% 80%,rgba(139,92,246,0.03) 0%,transparent 60%); }
.scanline-bar { position:fixed;inset:0;pointer-events:none;z-index:10;overflow:hidden; }
.scanline-bar div { width:100%;height:2px;background:linear-gradient(90deg,transparent,rgba(14,165,233,0.4),transparent);animation:scanline 2s linear infinite; }
.container { position:relative;z-index:1;max-width:640px;margin:0 auto;padding:48px 20px 60px; }
.tag-live { font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(14,165,233,0.12);color:#0EA5E9;letter-spacing:0.5px;flex-shrink:0; }
.tag-sim { font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.25);letter-spacing:0.5px;flex-shrink:0; }
.drop-zone { border:2px dashed rgba(255,255,255,0.12);border-radius:20px;padding:56px 32px;text-align:center;cursor:pointer;transition:all 0.3s ease;background:rgba(15,18,28,0.3);margin-bottom:28px; }
.drop-zone.has-file { padding:0;cursor:default;border-color:rgba(255,255,255,0.08);background:rgba(15,18,28,0.5); }
.drop-zone.dragging { border-color:#0EA5E9;background:rgba(14,165,233,0.05); }
.preview-wrap { width:100%;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,0.06);margin-bottom:14px;background:#0a0c14;display:flex;justify-content:center;min-height:120px; }
.preview-wrap img { max-width:100%;max-height:420px;object-fit:contain;display:block; }
.preview-wrap video { width:100%;max-height:420px;display:block; }
.btn-scan { flex:1;padding:14px 24px;background:linear-gradient(135deg,#0EA5E9,#6366F1);border:none;border-radius:12px;color:#fff;font-family:'Space Mono',monospace;font-size:13px;font-weight:700;cursor:pointer;letter-spacing:1px;text-transform:uppercase;transition:all 0.3s; }
.btn-scan:disabled { background:rgba(14,165,233,0.15);opacity:0.6;cursor:not-allowed; }
.btn-clear { padding:14px 20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;color:rgba(255,255,255,0.5);font-family:'Space Mono',monospace;font-size:12px;cursor:pointer; }
.btn-remove { background:rgba(255,255,255,0.06);border:none;border-radius:8px;padding:6px 14px;color:rgba(255,255,255,0.4);font-size:11px;font-family:'Space Mono',monospace;cursor:pointer;flex-shrink:0;margin-left:12px; }
.detector-row { display:flex;align-items:center;gap:14px;padding:14px 18px;border-radius:14px;transition:all 0.4s ease;border:1px solid rgba(255,255,255,0.03);background:rgba(15,18,28,0.3); }
.detector-row.done { background:rgba(15,18,28,0.5);border-color:rgba(255,255,255,0.06); }
.detector-row.unsupported { opacity:0.35; }
.verdict-badge { display:inline-block;padding:4px 10px;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600; }
.consensus-box { background:rgba(15,18,28,0.7);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.06);border-radius:20px;padding:36px 32px;margin-bottom:28px; }
</style>
</head>
<body>
<div class="ambient"></div>
<div id="app" class="container"></div>

<script>
// ════════════════════════════════════════════════════════════════
// FakeCheck v0.4 — Netlify Edition
// API keys are stored in Netlify environment variables.
// No keys in this file. All API calls go through /api/scan
// ════════════════════════════════════════════════════════════════

const DETECTORS = [
  { id: "sightengine", name: "Sightengine", color: "#0EA5E9", types: ["image","video","audio"], mode: "real" },
  { id: "hive", name: "Hive Detect", color: "#8B5CF6", types: ["image","video","audio"], mode: "real" },
  { id: "aiornot", name: "AI or Not", color: "#F59E0B", types: ["image","video","audio"], mode: "sim" },
  { id: "copyleaks", name: "Copyleaks", color: "#10B981", types: ["image"], mode: "sim" },
  { id: "sensity", name: "Sensity", color: "#EF4444", types: ["image","video","audio"], mode: "sim" },
  { id: "resemble", name: "Resemble.ai", color: "#EC4899", types: ["image","audio"], mode: "sim" },
  { id: "realitydefender", name: "Reality Defender", color: "#6366F1", types: ["image","video"], mode: "sim" },
];

const VERDICT_INFO = {
  ai:     { label: "AI Generated", color: "#EF4444", bg: "rgba(239,68,68,0.12)" },
  real:   { label: "Likely Real",  color: "#10B981", bg: "rgba(16,185,129,0.12)" },
  edited: { label: "AI Edited",    color: "#F59E0B", bg: "rgba(245,158,11,0.12)" },
  unsure: { label: "Unsure",       color: "#94A3B8", bg: "rgba(148,163,184,0.12)" },
  error:  { label: "Error",        color: "#64748B", bg: "rgba(100,116,139,0.12)" },
};

let state = { file: null, mediaType: null, previewData: null, scanning: false, detectorStates: {} };

function setState(patch) { Object.assign(state, patch); render(); }

// ─── Convert file to base64 for sending to serverless function ──
function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const base64 = reader.result.split(",")[1]; // strip data:... prefix
      resolve(base64);
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

// ─── Call serverless function ───────────────────────────────────
async function callDetectorAPI(service, file, mediaType) {
  const base64 = await fileToBase64(file);

  const resp = await fetch("/.netlify/functions/scan", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      service: service,
      mediaBase64: base64,
      mediaType: file.type,
      fileName: file.name,
    }),
  });

  if (!resp.ok) {
    const errText = await resp.text();
    throw new Error(errText || "Server error " + resp.status);
  }

  return await resp.json();
}

// ─── Parse Sightengine response ─────────────────────────────────
function parseSightengineResponse(data, mediaType) {
  if (data.status === "failure") throw new Error(data.error?.message || "Sightengine API error");

  let aiScore;
  if (mediaType === "video" && data.data?.frames) {
    const scores = data.data.frames.map(f => f.type?.ai_generated || 0);
    aiScore = scores.length ? scores.reduce((a, b) => a + b, 0) / scores.length : 0;
  } else {
    aiScore = data.type?.ai_generated ?? 0;
  }

  const confidence = Math.round(Math.max(aiScore, 1 - aiScore) * 100);
  let verdict;
  if (aiScore >= 0.7) verdict = "ai";
  else if (aiScore <= 0.3) verdict = "real";
  else if (aiScore >= 0.4) verdict = "edited";
  else verdict = "unsure";

  return { verdict, confidence, raw: aiScore };
}

// ─── Parse Hive response ────────────────────────────────────────
function parseHiveResponse(data) {
  if (data.status_code && data.status_code !== 200 && data.status_code !== 0) {
    throw new Error(data.message || "Hive API error");
  }

  let aiScore = 0;
  try {
    const outputs = data.status || [];
    for (const output of outputs) {
      const results = output.response?.output || [];
      for (const result of results) {
        const classes = result.classes || [];
        for (const cls of classes) {
          if (cls.class === "ai_generated") aiScore = cls.score || 0;
        }
      }
    }
  } catch (e) {
    throw new Error("Could not parse Hive response");
  }

  const confidence = Math.round(Math.max(aiScore, 1 - aiScore) * 100);
  let verdict;
  if (aiScore >= 0.7) verdict = "ai";
  else if (aiScore <= 0.3) verdict = "real";
  else if (aiScore >= 0.4) verdict = "edited";
  else verdict = "unsure";

  return { verdict, confidence, raw: aiScore };
}

// ─── Simulated detectors ────────────────────────────────────────
function simulateDetection() {
  return new Promise(resolve => {
    const delay = 1200 + Math.random() * 2800;
    const opts = ["ai","real","edited","unsure"];
    const wts = [0.35, 0.35, 0.15, 0.15];
    let r = Math.random(), v = "unsure", c = 0;
    for (let i = 0; i < wts.length; i++) { c += wts[i]; if (r < c) { v = opts[i]; break; } }
    const conf = v === "unsure" ? 30 + Math.random()*25 : 60 + Math.random()*35;
    setTimeout(() => resolve({ verdict: v, confidence: Math.round(conf) }), delay);
  });
}

function getMediaType(file) {
  if (file.type.startsWith("image/")) return "image";
  if (file.type.startsWith("video/")) return "video";
  if (file.type.startsWith("audio/")) return "audio";
  return null;
}

// ─── Actions ────────────────────────────────────────────────────
function handleFile(file) {
  const mt = getMediaType(file);
  if (!mt) return;
  const reader = new FileReader();
  reader.onload = (e) => setState({ file, mediaType: mt, previewData: e.target.result, detectorStates: {} });
  reader.readAsDataURL(file);
}

function resetAll() {
  setState({ file: null, mediaType: null, previewData: null, scanning: false, detectorStates: {} });
}

async function runScan() {
  if (!state.file || !state.mediaType) return;

  const init = {};
  DETECTORS.forEach(d => {
    init[d.id] = d.types.includes(state.mediaType)
      ? { status: "scanning", result: null, error: null }
      : { status: "na", result: null, error: null };
  });
  setState({ scanning: true, detectorStates: init });

  const applicable = DETECTORS.filter(d => d.types.includes(state.mediaType));
  const file = state.file;
  const mediaType = state.mediaType;

  const promises = applicable.map(async (det) => {
    try {
      let result;
      if (det.id === "sightengine") {
        const data = await callDetectorAPI("sightengine", file, mediaType);
        result = parseSightengineResponse(data, mediaType);
      } else if (det.id === "hive") {
        const data = await callDetectorAPI("hive", file, mediaType);
        result = parseHiveResponse(data);
      } else {
        result = await simulateDetection();
      }
      state.detectorStates[det.id] = { status: "done", result, error: null };
      render();
    } catch (err) {
      state.detectorStates[det.id] = { status: "done", result: { verdict: "error", confidence: 0 }, error: err.message };
      render();
    }
  });

  await Promise.all(promises);
  setState({ scanning: false });
}

// ─── Render ─────────────────────────────────────────────────────
function render() {
  const app = document.getElementById("app");
  const { file, mediaType, previewData, scanning, detectorStates } = state;

  const applicable = DETECTORS.filter(d => d.types.includes(mediaType));
  const doneCount = Object.values(detectorStates).filter(s => s.status === "done").length;
  const allDone = doneCount === applicable.length && applicable.length > 0;

  let scanlineEl = document.getElementById("scanline-fx");
  if (scanning && !scanlineEl) {
    scanlineEl = document.createElement("div"); scanlineEl.id = "scanline-fx"; scanlineEl.className = "scanline-bar";
    scanlineEl.innerHTML = "<div></div>"; document.body.appendChild(scanlineEl);
  } else if (!scanning && scanlineEl) { scanlineEl.remove(); }

  let html = "";

  // Header
  html += `
    <div style="margin-bottom:40px">
      <div style="font-size:10px;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-bottom:12px">Media Forensics Tool</div>
      <h1 style="font-family:'Instrument Serif',serif;font-size:44px;font-weight:400;line-height:1.1;margin-bottom:12px">FakeCheck</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.35);line-height:1.6;max-width:480px">
        Upload media and run it through multiple AI detectors for a consensus verdict.
        <span style="color:#0EA5E9">Sightengine + Hive are live.</span>
      </p>
    </div>`;

  // Drop zone
  if (!file) {
    html += `
      <div class="drop-zone" id="dropzone" onclick="document.getElementById('fileinput').click()">
        <input type="file" id="fileinput" accept="image/*,video/*,audio/*" style="display:none" />
        <div style="font-size:48px;margin-bottom:16px;opacity:0.6">🔍</div>
        <div style="font-family:'Instrument Serif',serif;font-size:22px;color:rgba(255,255,255,0.7);margin-bottom:8px">Drop your file here</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.3);letter-spacing:0.5px">Images, video, or audio — JPG PNG MP4 MP3 WAV</div>
      </div>`;
  } else {
    html += `<div class="drop-zone has-file"><div style="padding:16px">`;
    if (mediaType === "image" && previewData) {
      html += `<div class="preview-wrap"><img src="${previewData}" alt="Preview" /></div>`;
    } else if (mediaType === "video" && previewData) {
      html += `<div class="preview-wrap"><video src="${previewData}" controls></video></div>`;
    } else if (mediaType === "audio") {
      html += `<div style="display:flex;flex-direction:column;align-items:center;padding:24px 0 14px;gap:16px">
        <div style="width:72px;height:72px;border-radius:16px;background:linear-gradient(135deg,rgba(139,92,246,0.25),rgba(14,165,233,0.2));display:flex;align-items:center;justify-content:center;font-size:36px">🎵</div>
        ${previewData ? `<audio src="${previewData}" controls style="width:100%;max-width:420px"></audio>` : ""}
      </div>`;
    }
    html += `<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 4px 0">
      <div style="min-width:0;flex:1">
        <div style="font-size:13px;color:#fff;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${file.name}</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(255,255,255,0.3);margin-top:2px">
          ${mediaType?.toUpperCase()} • ${file.size > 1048576 ? (file.size/1048576).toFixed(1)+" MB" : (file.size/1024).toFixed(0)+" KB"}
        </div>
      </div>
      <button class="btn-remove" onclick="resetAll()">✕ Remove</button>
    </div></div></div>`;
  }

  // Buttons
  if (file) {
    html += `<div style="display:flex;gap:12px;margin-bottom:28px">
      <button class="btn-scan" onclick="runScan()" ${scanning ? "disabled" : ""}>
        ${scanning ? `Scanning… (${doneCount}/${applicable.length})` : allDone ? "Re-Scan" : "Run All Detectors"}
      </button>
      <button class="btn-clear" onclick="resetAll()">Clear</button>
    </div>`;
  }

  // Consensus
  if (allDone) {
    const validResults = Object.entries(detectorStates)
      .filter(([_,s]) => s.status==="done" && s.result && !s.error && s.result.verdict!=="unsure" && s.result.verdict!=="error");
    if (validResults.length > 0) {
      const aiCount = validResults.filter(([_,s]) => s.result.verdict==="ai"||s.result.verdict==="edited").length;
      const realCount = validResults.filter(([_,s]) => s.result.verdict==="real").length;
      const total = validResults.length;
      const aiPct = Math.round((aiCount/total)*100);
      const realPct = Math.round((realCount/total)*100);
      const avgConf = Math.round(validResults.reduce((sum,[_,s])=>sum+s.result.confidence,0)/total);
      let verdict, vColor;
      if (aiPct>=70) { verdict="High likelihood AI-generated"; vColor="#EF4444"; }
      else if (aiPct>=50) { verdict="Likely AI-generated"; vColor="#F59E0B"; }
      else if (realPct>=70) { verdict="Likely authentic"; vColor="#10B981"; }
      else { verdict="Inconclusive — needs review"; vColor="#94A3B8"; }
      const circ = 2*Math.PI*54, arc = (aiPct/100)*circ;
      html += `<div class="consensus-box" style="animation:fadeIn 0.4s ease">
        <div style="display:flex;align-items:center;gap:40px;flex-wrap:wrap;justify-content:center">
          <div style="position:relative;width:130px;height:130px">
            <svg width="130" height="130" viewBox="0 0 130 130">
              <circle cx="65" cy="65" r="54" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="10"/>
              <circle cx="65" cy="65" r="54" fill="none" stroke="${vColor}" stroke-width="10" stroke-dasharray="${arc} ${circ-arc}" stroke-dashoffset="${circ*0.25}" stroke-linecap="round" style="transition:stroke-dasharray 1s ease"/>
            </svg>
            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center">
              <span style="font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;color:${vColor}">${aiPct}%</span>
              <span style="font-size:10px;color:rgba(255,255,255,0.4);letter-spacing:1px;text-transform:uppercase">AI signals</span>
            </div>
          </div>
          <div style="flex:1;min-width:200px">
            <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:8px">Consensus Verdict</div>
            <div style="font-family:'Instrument Serif',serif;font-size:26px;color:${vColor};line-height:1.3;margin-bottom:12px">${verdict}</div>
            <div style="display:flex;gap:24px;flex-wrap:wrap">
              <div><div style="font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600">${aiCount}/${total}</div><div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:2px">AI votes</div></div>
              <div><div style="font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600">${realCount}/${total}</div><div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:2px">Real votes</div></div>
              <div><div style="font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600">${avgConf}%</div><div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:2px">Avg conf.</div></div>
            </div>
          </div>
        </div>
        <div style="margin-top:20px;padding:12px 16px;background:rgba(255,255,255,0.03);border-radius:10px;font-size:11px;color:rgba(255,255,255,0.35);line-height:1.6">
          This is a consensus estimate only. Always verify with source context and additional research.
        </div>
      </div>`;
    }
  }

  // Detector rows
  if (Object.keys(detectorStates).length > 0) {
    html += `<div style="animation:fadeIn 0.4s ease">
      <div style="font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-bottom:14px">Individual Results</div>
      <div style="display:flex;flex-direction:column;gap:8px">`;
    DETECTORS.forEach(det => {
      const s = detectorStates[det.id] || {};
      const supported = det.types.includes(mediaType);
      const isLive = det.mode === "real";
      const vi = s.result ? VERDICT_INFO[s.result.verdict] : null;
      const dotColor = s.status==="done" ? (s.error?"#64748B":vi?.color||"#94A3B8") : s.status==="scanning"?det.color:"rgba(255,255,255,0.15)";
      const dotShadow = s.status==="scanning"?`0 0 12px ${det.color}`:"none";
      const dotAnim = s.status==="scanning"?"pulse 1.2s infinite":"none";
      html += `<div class="detector-row ${s.status==='done'?'done':''} ${!supported?'unsupported':''}">
        <div style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:${dotColor};box-shadow:${dotShadow};animation:${dotAnim}"></div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:600;display:flex;align-items:center;gap:8px">
            ${det.name} <span class="${isLive?'tag-live':'tag-sim'}">${isLive?'LIVE':'SIM'}</span>
          </div>
          ${!supported?`<div style="font-size:10px;color:rgba(255,255,255,0.25);margin-top:2px">No ${mediaType} support</div>`:""}
          ${s.error?`<div style="font-size:10px;color:#EF4444;margin-top:2px;word-break:break-word">${s.error}</div>`:""}
        </div>
        <div style="text-align:right;min-width:110px;flex-shrink:0">
          ${s.status==="idle"&&supported?`<span style="font-size:11px;color:rgba(255,255,255,0.2)">Ready</span>`:""}
          ${s.status==="scanning"?`<span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:${det.color};letter-spacing:1px">SCANNING…</span>`:""}
          ${s.status==="done"&&s.result&&!s.error?`
            <span class="verdict-badge" style="background:${vi.bg};color:${vi.color}">${vi.label}</span>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,0.3);margin-top:4px">
              ${s.result.confidence}% conf${s.result.raw!==undefined&&isLive?` <span style="margin-left:4px;color:rgba(14,165,233,0.5)">raw:${(s.result.raw*100).toFixed(1)}%</span>`:""}
            </div>`:""}
          ${s.status==="done"&&s.error?`<span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#64748B">FAILED</span>`:""}
          ${!supported?`<span style="font-size:11px;color:rgba(255,255,255,0.15)">N/A</span>`:""}
        </div>
      </div>`;
    });
    html += `</div></div>`;
  }

  // How it works
  if (!file) {
    html += `<div style="margin-top:48px;padding:28px 24px;background:rgba(15,18,28,0.4);border:1px solid rgba(255,255,255,0.04);border-radius:16px">
      <div style="font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.2);margin-bottom:16px">How It Works</div>
      ${[
        {n:"01",t:"Upload any image, video, or audio file"},
        {n:"02",t:"FakeCheck sends the raw file to multiple AI detectors in parallel"},
        {n:"03",t:"Each detector independently returns a verdict and confidence"},
        {n:"04",t:"A consensus score is computed — no single detector is trusted alone"},
      ].map(s=>`<div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:12px">
        <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:rgba(14,165,233,0.5);font-weight:700;min-width:24px">${s.n}</span>
        <span style="font-size:13px;color:rgba(255,255,255,0.45);line-height:1.5">${s.t}</span>
      </div>`).join("")}
    </div>`;
  }

  // Footer
  html += `<div style="margin-top:48px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.04);font-size:10px;color:rgba(255,255,255,0.15);line-height:1.8;text-align:center">
    FakeCheck v0.4 — Sightengine + Hive LIVE via secure backend<br>
    API keys stored server-side. Raw file bytes sent to detectors.<br>
    No single detector is 100% accurate. Always verify with context.
  </div>`;

  app.innerHTML = html;

  // Rebind events
  const fileinput = document.getElementById("fileinput");
  if (fileinput) fileinput.addEventListener("change", (e) => { if (e.target.files[0]) handleFile(e.target.files[0]); });
  const dropzone = document.getElementById("dropzone");
  if (dropzone) {
    dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("dragging"); });
    dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dragging"));
    dropzone.addEventListener("drop", (e) => { e.preventDefault(); dropzone.classList.remove("dragging"); if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]); });
  }
}

render();
</script>
</body>
</html>
